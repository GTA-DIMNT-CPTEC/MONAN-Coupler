!=======================================================================
! nuopc.input: configuração do MONAN-Coupler
! MONAN-A 2.0 + MOM6 + SIS2, acoplados por ESMF/NUOPC 8.9.1
! INPE / CGCT / DIMNT, GT Acoplamento de Modelos
!
! Os valores abaixo são a configuração de produção e a da validação bit a
! bit (linha de base R-NOFMA-02): MONAN-A, MOM6 e SIS2, execução
! concorrente em 152 PETs, 29 a 30/03/2026.
!
! Leitura: src/shared/coupler_config.F90, no início da rodada. O arquivo é
! o nuopc.input do diretório de execução ou o indicado pela variável de
! ambiente NUOPC_INPUT. Grupo ou chave omitidos ficam com o valor padrão;
! erro de sintaxe num grupo para a rodada. Os scripts (run/run_esmApp.jaci,
! tools/coupler) leem uma chave por linha: mantenha esse formato.
!
! Grupos:
!   &nuopc_driver     datas, passos de tempo e registro
!   &nuopc_mode       modelo de cada posição (ATM, OCN, ICE)
!   &nuopc_petlayout  ordem de execução e divisão dos PETs
!   &nuopc_atm        cap da atmosfera
!   &nuopc_atm_bnd    contorno da atmosfera antes do primeiro acoplamento
!   &nuopc_netcdf     diagnóstico da exportação da atmosfera
!   &nuopc_ocn        MOM6
!   &nuopc_docn       oceano de dados (OISST) e diagnóstico da importação
!   &nuopc_regrid     troca de esquema de interpolação (opcional)
!=======================================================================

!-----------------------------------------------------------------------
! &nuopc_driver
!   start_date, stop_date  período da rodada, 'AAAA-MM-DD'
!   dt_coupling  intervalo de acoplamento [s], múltiplo de dt_atm
!                (padrão 1800; 3600 é o usado com o MOM6 global)
!   dt_atm       passo do MONAN-A [s]; igual a config_dt do
!                namelist.atmosphere
!   log_dir      diretório dos logs do ESMF e da saída padrão
!   log_kind     'multi': um log por PET, sempre (padrão; necessário às
!                ferramentas de tempo por passo e à validação)
!                'multi_on_error': logs só em caso de erro (mais rápido)
!   log_level    'warning' | 'info' (padrão) | 'debug' (inclui os
!                diagnósticos do mediador, linhas DIAG)
!   run_sequence_file  (opcional) arquivo com outra ordem de execução, no
!                formato do NUOPC (rótulo runSeq::), para testar sem
!                recompilar; vazio: a sequência de RUN_SEQUENCES
!                (src/driver/run_sequences.F90). Muda resultados.
!-----------------------------------------------------------------------
&nuopc_driver
  start_date  = '2026-03-29'
  stop_date   = '2026-03-30'
  dt_coupling = 3600
  dt_atm      = 60
  log_dir     = 'logs'
  log_kind    = 'multi'
  log_level   = 'info'
/

!-----------------------------------------------------------------------
! &nuopc_mode
!   atm_model     'mpas' (MONAN-A) | 'datm' (JRA55; ainda não registrado
!                 no driver)
!   ocn_model     'mom6' | 'docn' (OISST)
!   ice_model     'sis2' | 'none'
!   atm_boundary  'med': a atmosfera recebe a superfície do oceano pelo
!                 mediador (obrigatório com o MOM6)
!                 'ocn': direto do oceano (só com o DOCN)
!   use_docn_ice        fração de gelo do arquivo OISST (&nuopc_docn) em
!                       vez da aproximação pela SST
!   docn_ice_init_only  com use_docn_ice: OISST só no passo inicial
!
! Combinações aceitas, avisadas ou recusadas: tabela COUPLER_MODES
! (src/shared/coupler_config.F90). Só MONAN-A + MOM6 + contorno pelo
! mediador, com ou sem o SIS2, é validada; DOCN e DATM rodam com aviso.
! As chaves antigas (use_datm, use_docn, use_med_to_mpas e, em
! &nuopc_petlayout, use_sis2_dynamic) ainda são aceitas, com aviso.
!-----------------------------------------------------------------------
&nuopc_mode
  atm_model          = 'mpas'
  ocn_model          = 'mom6'
  ice_model          = 'sis2'
  atm_boundary       = 'med'
  use_docn_ice       = .false.
  docn_ice_init_only = .false.
/

!-----------------------------------------------------------------------
! &nuopc_petlayout
!   coupling_mode  'concurrent': ATM, OCN e ICE avançam juntos, cada um
!                  com os campos do passo anterior (mais rápido)
!                  'sequential' (padrão): um depois do outro
!   pet_layout     'split': cada modelo no seu bloco de PETs (obrigatório
!                  com concurrent) | 'shared' (padrão): todos em todos
!   atm_pet_count, ocn_pet_count, ice_pet_count
!                  PETs de cada modelo com split; a soma é o total da
!                  rodada (run_esmApp.jaci -n); 0 completa
!                  automaticamente; com shared, todos 0. A partição do
!                  MONAN-A segue atm_pet_count, não o total.
!   seq_repro      com sequential + split + SIS2: mesma ordem dos dados
!                  do modo concorrente, com resultados iguais bit a bit;
!                  ignorado (com aviso) no modo concorrente
!-----------------------------------------------------------------------
&nuopc_petlayout
  coupling_mode = 'concurrent'
  pet_layout    = 'split'
  atm_pet_count = 128
  ocn_pet_count = 20
  ice_pet_count = 4
  seq_repro     = .true.
/

!-----------------------------------------------------------------------
! &nuopc_atm
!   config_dir  diretório do namelist.atmosphere e dos streams do MONAN-A
!   write_diag  campos do cap no log do ESMF (depuração; aumenta o log)
!-----------------------------------------------------------------------
&nuopc_atm
  config_dir = './'
  write_diag = .false.
/

!-----------------------------------------------------------------------
! &nuopc_atm_bnd
!   Valores da superfície que o MONAN-A usa até receber o primeiro campo
!   do acoplamento: SST [K], fração de gelo [0 a 1] e rugosidade [m].
!-----------------------------------------------------------------------
&nuopc_atm_bnd
  sst_default          = 298.0
  ice_fraction_default = 0.0
  zorl_default         = 0.01
/

!-----------------------------------------------------------------------
! &nuopc_netcdf
!   write_netcdf  grava a exportação do MONAN-A em
!                 <output_dir>/monan_export_*.nc, um arquivo por passo
!   grid_res_deg  resolução da grade lat/lon desses arquivos e dos de
!                 importação do MONAN-A [grau], em (0, 10]
!-----------------------------------------------------------------------
&nuopc_netcdf
  write_netcdf = .true.
  output_dir   = 'diag_export'
  grid_res_deg = 1.0
/

!-----------------------------------------------------------------------
! &nuopc_ocn
!   mesh_ocn  supergrade do MOM6 (ocean_hgrid.nc); o mediador e o cap do
!             gelo leem dela a grade do oceano
!-----------------------------------------------------------------------
&nuopc_ocn
  mesh_ocn = 'INPUT/ocean_hgrid.nc'
/

!-----------------------------------------------------------------------
! &nuopc_docn
! Lido sempre, também com o MOM6: write_import_diag e import_diag_dir
! valem para os dois oceanos.
!
!   write_import_diag  grava em <import_diag_dir> os campos que a
!                      atmosfera e o oceano recebem (monan2_import_*.nc,
!                      mom6_import_*.nc), um arquivo por passo; faz parte
!                      dos arquivos comparados na validação
!
! Demais chaves: só com ocn_model = 'docn' ou use_docn_ice = .true.
!   docn_mode          'netcdf' (único modo: lê os arquivos abaixo)
!   docn_nx, docn_ny   grade dos arquivos (1440 x 720: OISST 0,25 grau)
!   docn_dt_data       intervalo entre registros [s] (86400: diário)
!   docn_epoch_*       data do primeiro registro DO ARQUIVO usado
!   docn_*_file        SST, gelo e correntes (correntes: '' desliga)
!   docn_*_varname     nomes das variáveis nos arquivos
!   docn_ice_pct       .true. se o gelo vier em porcentagem
!-----------------------------------------------------------------------
&nuopc_docn
  write_import_diag  = .true.
  import_diag_dir    = 'diag_import'
  docn_mode          = 'netcdf'
  docn_nx            = 1440
  docn_ny            = 720
  docn_dt_data       = 86400
  docn_epoch_year    = 2026
  docn_epoch_month   = 1
  docn_epoch_day     = 1
  docn_sst_file      = 'INPUT/OISST_sst.nc'
  docn_ice_file      = 'INPUT/OISST_ice.nc'
  docn_cur_file      = 'INPUT/OISST_cur.nc'
  docn_sst_varname   = 'sst'
  docn_ice_varname   = 'icec'
  docn_cur_u_varname = 'u'
  docn_cur_v_varname = 'v'
  docn_ice_pct       = .false.
/

!-----------------------------------------------------------------------
! &nuopc_regrid (opcional)
! Troca, sem recompilar, a interpolação de uma rota do mediador (até 16).
! Vazio: cada rota usa a configuração da tabela ROUTES
! (src/coupling/cpl_map.F90). Muda resultados.
!   regrid_route(i)    atm2ocn | ocn2atm | ocn2atm_sst | ocn2atm_ice |
!                      ocn2atm_landmask | atm2ocn_ice
!   regrid_scheme(i)   esmf | weights_file | mpassit | idw
!   regrid_methods(i)  métodos em ordem de preferência, por vírgula
!                      (bilinear, conserve, patch, nearest_stod, ...)
!   regrid_weights(i)  arquivo de pesos (weights_file)
!   regrid_class(i)    continuous | integer | accumulated (mpassit)
!   regrid_options(i)  'chave=valor,...' (idw: vizinhos, expoente)
! Exemplo:
!   regrid_route(1)  = 'ocn2atm_sst'
!   regrid_scheme(1) = 'idw'
!   regrid_options(1) = 'vizinhos=6,expoente=2'
!-----------------------------------------------------------------------
&nuopc_regrid
/
